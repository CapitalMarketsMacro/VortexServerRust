# Vendored Conan artifacts are large binaries — store them via Git LFS so the
# git history stays lean. Requires `git lfs install` (one-time) on any machine
# that clones; without git-lfs these paths resolve to small pointer files and
# the build falls back to downloading/compiling (see perspective-server/build.rs).
Vortex/crates/perspective-server/vendor/**/*.tgz    filter=lfs diff=lfs merge=lfs -text
Vortex/crates/perspective-server/vendor/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Shell scripts must keep LF endings so they run on Linux/macOS.
*.sh text eol=lf
